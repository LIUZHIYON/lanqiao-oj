 -948327680 730464988 -978054286 -557921605 301125562 205601842 384205336 -899413299 979739066 -250154546 67824388 893402951 -927240949 167580996 -30169880 844402357 -681083666 -556766847 -449755688 -748727426 48319604 810721800 -212768870 254043260 -457010579 -329621264 -272338615 -789325117 32067970 -924392606 -65773086 765394343 29928673 60366594 -695306556 495255767 736736840 -404217339 -839150735 581072397\n",
