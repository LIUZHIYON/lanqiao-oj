9 866559 937799 707249 788273 369552 788273 788273 788273 857117 -785789 -393569 308427 547015 642589 642589 642589 857117 857117 102176 102176 857117 937799 937799 319601 937799 937799 958982 500800 754407 754407 754407 754407 924439 924439 924439 924439 924439 958982 753404 876147 876147 537242 876147 104274 876147 958982 807579 958982 -68112 201274 201274 556557 556557 574656 513377 -752391 513377 574656 342735 -145187 342735 574656 629874 -755621 -4138 52006 71701 71701 629874 629874 958982 958982 958982 -439229 -247281 -76803 -76803 958982 958982 960688 476690 776563 776563 960688 960688 980996 820777 734420 778593 778593 778593 820777 646088 820777 825081 825081 -52138 149471 149471 248399 825081 -492647 84086 825081 -433879 -407156 -407156 -218653 825081 980996 980996 616034 980996 980996 -1 422165 612539 -432155 50527 50527 -714902 50527 95474 -520069 95474 612539 -305229 612539 612539 657456 722652 722652 722652 906080 -616427 906080 938566 754141 445214 -321221 -321221 445214 445214 685414 -805336 263205 685414 685414 754141 754141 754141 861607 861607 455154 -90596 -90596 455154 455154 861607 938566 269033 542708 542708 -526010 -643742 -526010 -526010 105946 105946 -664110 -664110 -976673 -664110 105946 542708 542708 -420642 542708 938566 938566 972870 -136779 778744 825881 179992 741741 741741 741741 825881 923229 101013 923229 923229 972870 -1 737511 798508 666393 798508 369666 798508 -49751 176084 -316110 176084 250611 250611 250611 798508 965980 -1 258795 878932 878932 -1 425439 -1 -1 -50160 -1\r\n",
